{
  "name": "ohmyxcpc",
  "version": "1.0.0",
  "description": "面向 ICPC / CCPC 的现代 C++ 算法模板库：简明说明、清晰代码，支持在线搜索与整本 / 分章 PDF 下载。",
  "homepage": "https://l-1ngg.github.io/ohmyxcpc/",
  "repository": {
    "type": "git",
    "url": "https://github.com/L-1ngg/ohmyxcpc.git"
  },
  "bugs": "https://github.com/L-1ngg/ohmyxcpc/issues",
  "license": "ISC",
  "author": "L-1ngg",
  "packageManager": "pnpm@10.22.0",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "export:pdf": "node scripts/export-pdf.mjs",
    "prebuild:pdf": "node scripts/prebuild-pdfs.mjs",
    "release": "pnpm prebuild:pdf && pnpm build",
    "smoke": "node scripts/smoke-export.mjs",
    "setup:fonts": "node scripts/setup-fonts.mjs",
    "typecheck": "vue-tsc --noEmit -p .vitepress/tsconfig.json",
    "test": "node --test scripts/tests/*.test.mjs",
    "check:code": "node scripts/check-code.mjs",
    "check:pdf": "uv run --with pymupdf==1.26.7 --with pypdf==6.2.0 python scripts/check-pdfs.py"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "markdown-it": "^15.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-mathjax3": "^4.3.2",
    "playwright-core": "^1.62.1",
    "typescript": "~5.9.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.41",
    "vue-tsc": "~3.1.8"
  }
}
